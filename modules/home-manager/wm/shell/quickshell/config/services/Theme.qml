pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io

// Stylix palette and store paths, generated by Nix into theme.json.
// Roles follow the shared shell theme (theme.nix): base0E is the accent
// that hakuspace's @accent_color played.
Singleton {
    id: root

    FileView {
        id: file
        path: Quickshell.shellDir + "/theme.json"
        blockLoading: true
    }

    readonly property var data: JSON.parse(file.text())
    readonly property var colors: data.colors
    readonly property var bin: data.bin

    readonly property color base: colors.base00
    readonly property color mantle: colors.base01
    readonly property color surface: colors.base02
    readonly property color overlay: colors.base03
    readonly property color subtext: colors.base04
    readonly property color text: colors.base05
    readonly property color bright: colors.base06
    readonly property color red: colors.base08
    readonly property color orange: colors.base09
    readonly property color yellow: colors.base0A
    readonly property color green: colors.base0B
    readonly property color cyan: colors.base0C
    readonly property color blue: colors.base0D
    readonly property color accent: colors.base0E

    readonly property string font: data.font.family
    readonly property real fontSize: data.font.size
    readonly property real popupFontSize: data.font.popup
    readonly property int radius: data.radius
    readonly property real glass: data.glass

    readonly property int barHeight: 34
    readonly property int pillRadius: 8
    // hakuspace eases everything with cubic-bezier(0, 0.5, 0.35, 1).
    readonly property var easing: [0, 0.5, 0.35, 1, 1, 1]

    function alpha(c, a) {
        return Qt.rgba(c.r, c.g, c.b, a)
    }

    // For untrusted strings shown in StyledText labels.
    function plain(s) {
        return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
    }
}
