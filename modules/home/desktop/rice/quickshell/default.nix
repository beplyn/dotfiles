# Quickshell panels, notifications, OSD, recorder; Nix only writes Stylix.qml.
{
  config,
  lib,
  osConfig,
  pkgs,
  ...
}:

let
  t = config.themes.shell;
  p = config.themes.palette;
  fonts = config.stylix.fonts;

  record = pkgs.writeShellApplication
  {
    name = "record";
    runtimeInputs = with pkgs;
    [
      wl-screenrec
      pulseaudio # pactl, pacat
      pipewire # pw-metadata
      libnotify
      jq
      procps
      osConfig.programs.hyprland.package
    ];
    text = builtins.readFile ./record.sh;
  };

  eapConnect = pkgs.writeShellApplication
  {
    name = "eap-connect";
    runtimeInputs = [ osConfig.networking.networkmanager.package ];
    text = builtins.readFile ./eap-connect.sh;
  };

  sharePicker = pkgs.writeShellApplication
  {
    name = "share-picker";
    runtimeInputs = [ config.programs.quickshell.package pkgs.coreutils ];
    text = builtins.readFile ./share-picker.sh;
  };

  cavaConfig = (pkgs.formats.ini { }).generate "haku-cava.conf"
  {
    general =
    {
      bars = 28;
      framerate = 60;
      sleep_timer = 1;
      autosens = true;
      sensitivity = 100;
      lower_cutoff_freq = 50;
      higher_cutoff_freq = 12000;
    };
    input =
    {
      method = "pipewire";
      source = "auto";
    };
    output =
    {
      method = "raw";
      raw_target = "/dev/stdout";
      data_format = "ascii";
      ascii_max_range = 7;
      bar_delimiter = 59; # ';'
      frame_delimiter = 10; # '\n'
    };
    smoothing =
    {
      noise_reduction = 0.77;
      monstercat = true;
      waves = true;
    };
  };

  cavaVisualizer = pkgs.writeShellApplication
  {
    name = "cava-visualizer";
    runtimeInputs =
    [
      pkgs.cava
      pkgs.gawk
    ];
    text = ''
      exec cava -p ${cavaConfig} | awk -F';' '
        BEGIN {
          glyphs[0] = " ";
          glyphs[1] = "▁";
          glyphs[2] = "▂";
          glyphs[3] = "▃";
          glyphs[4] = "▄";
          glyphs[5] = "▅";
          glyphs[6] = "▆";
          glyphs[7] = "█";
        }
        {
          frame = "";
          for (i = 1; i <= NF; i++) {
            value = $i + 0;
            if (value < 0) value = 0;
            if (value > 7) value = 7;
            frame = frame glyphs[value];
          }
          print frame;
          fflush();
        }
      '
    '';
  };

  bin =
  {
    record = lib.getExe record;
    eapConnect = lib.getExe eapConnect;
    cava = lib.getExe pkgs.cava;
    cavaVisualizer = lib.getExe cavaVisualizer;
    inherit cavaConfig;
    clipboard = lib.getExe config.lib.haku.clipboard;
    # the launcher (launcher/LauncherMenu.qml); apps start in a scope of
    # their own, out of quickshell.service
    systemdRun = lib.getExe' osConfig.systemd.package "systemd-run";
    env = lib.getExe' pkgs.coreutils "env";
    terminal = lib.getExe config.programs.wezterm.package;
    xdgOpen = lib.getExe' pkgs.xdg-utils "xdg-open";
    wlCopy = lib.getExe' pkgs.wl-clipboard "wl-copy";
    # via hypridle, which skips an already running hyprlock
    lock = "${lib.getExe' pkgs.systemd "loginctl"} lock-session";
    brightnessctl = lib.getExe pkgs.brightnessctl;
    # monitor brightness over DDC/CI, when there is no backlight
    ddcutil = lib.getExe pkgs.ddcutil;
    # night light (services/NightLight.qml) through hyprsunset
    hyprctl = lib.getExe' osConfig.programs.hyprland.package "hyprctl";
    mixer = lib.getExe pkgs.pavucontrol;
    # set, random, current (wallpaper.nix)
    wallpaper = config.lib.haku.wallpaper.bin;
    systemctl = lib.getExe' osConfig.systemd.package "systemctl";
    pkill = lib.getExe' pkgs.procps "pkill";
    # stay awake (services/Awake.qml)
    systemdInhibit = lib.getExe' osConfig.systemd.package "systemd-inhibit";
    sleep = lib.getExe' pkgs.coreutils "sleep";
    # answers share-picker's fifo (services/SharePicker.qml)
    tee = lib.getExe' pkgs.coreutils "tee";
    # the calendar CLI (services/Events.qml)
    vcal = config.lib.haku.calendar.bin;
  };

  # SIGRTMIN+n to refresh a waybar module
  waybarSignals =
  {
    notifications = 8;
    recorder = 9;
  };

  laptop = osConfig.laptop.enable;

  # Stylix.qml: one property per value, strings via toJSON
  prop = type: name: value: "    readonly property ${type} ${name}: ${value}";
  str = name: value: prop "string" name (builtins.toJSON (toString value));
  num = name: value: prop "real" name (toString value);
  stylixQml = pkgs.writeText "Stylix.qml" (
    lib.concatLines (
      [
        "pragma Singleton"
        "import QtQuick"
        "import Quickshell"
        ""
        "// Generated by quickshell/default.nix from Stylix and the shell theme. Edit it there."
        "Singleton {"
      ]
      ++ lib.mapAttrsToList (n: v: prop "color" n (builtins.toJSON v)) p
      ++
      [
        ""
        (str "monoFont" fonts.monospace.name)
        (str "sansFont" fonts.sansSerif.name)
        (num "fontSize" fonts.sizes.desktop)
        (num "popupFontSize" fonts.sizes.popups)
        (num "radius" t.radius)
        (num "opacity" t.glass)
        (num "gap" t.gaps)
        (prop "bool" "laptop" (lib.boolToString laptop))
        # one database for the TUI and the dashboard (calendar.nix)
        (str "calendarDb" config.lib.haku.calendar.db)
        # the recoloured wallpapers and their thumbnails (wallpaper.nix)
        (str "wallpapers" config.lib.haku.wallpaper.cache)
        (prop "var" "calendarOpen" (builtins.toJSON config.lib.haku.calendar.open))
        # titled binds for the hotkey overlay
        (prop "var" "hotkeys" (builtins.toJSON config.lib.haku.hyprlandHotkeys))
        ""
        "    readonly property QtObject signals: QtObject {"
      ]
      ++ lib.mapAttrsToList (n: v: "    " + prop "int" n (toString v)) waybarSignals
      ++
      [
        "    }"
        ""
        "    readonly property QtObject bin: QtObject {"
      ]
      ++ lib.mapAttrsToList (n: v: "    " + str n v) bin
      ++
      [
        "    }"
        "}"
      ]
    )
  );

  # copied so `import qs.services` finds it
  shellConfig = pkgs.runCommandLocal "quickshell-haku" { } ''
    cp -r ${./config} $out
    chmod -R u+w $out
    cp ${stylixQml} $out/services/Stylix.qml
  '';

  qs = lib.getExe' config.programs.quickshell.package "qs";
in
{
  imports = [ ./wallpaper.nix ];

  programs.quickshell =
  {
    enable = true;
    configs.haku = shellConfig;
    activeConfig = "haku";
    systemd.enable = true;
  };

  # xdph asks the shell what to share (sharepicker/SharePickerMenu.qml)
  xdg.configFile."hypr/xdph.conf".text = ''
    screencopy {
      custom_picker_binary = ${lib.getExe sharePicker}
    }
  '';

  # reload on config change
  systemd.user.services.quickshell.Unit.X-Restart-Triggers = [ "${shellConfig}" ];

  home.packages = [ record ];

  lib.haku.waybarSignals = waybarSignals;
  lib.haku.cava =
  {
    inherit cavaConfig cavaVisualizer;
  };

  # argv for `qs ipc call`
  lib.haku.ipc = target: fn:
  [
    qs
    "-c"
    "haku"
    "ipc"
    "call"
    target
    fn
  ];
}
